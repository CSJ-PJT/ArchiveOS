[Unit]
Description=Import previous-day ArchiveOS edge access aggregates
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
User=root
Group=root
Environment=ATLAS_ACCESS_START_DATE=2026-08-27
Environment=ACCESS_REPORT_SOURCE=archiveos
Environment=ATLAS_ACCESS_STATE_DIR=/var/lib/archiveos-access-monitor
EnvironmentFile=/etc/atlas-access-monitor.env
StateDirectory=archiveos-access-monitor
StateDirectoryMode=0700
RuntimeDirectory=archiveos-access-monitor
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/flock -n /run/archiveos-access-monitor/run.lock /usr/bin/node /usr/local/libexec/atlas-access-monitor.mjs report --force --import-archiveos --source archiveos
UMask=0077
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadOnlyPaths=/var/log/nginx /etc/atlas-access-monitor.env
ReadWritePaths=/var/lib/archiveos-access-monitor /run/archiveos-access-monitor
RestrictAddressFamilies=AF_INET AF_INET6

